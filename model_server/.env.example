# Copy to model_server/.env on the GPU machine. Never commit it.
# The same key as MODEL_SERVER_API_KEY in the application's .env.
MODEL_SERVER_API_KEY=

# Optional (defaults shown)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBED_MAX_TOKENS=1024
RERANK_MAX_TOKENS=1024
GPU_BATCH_SIZE=32
