# Copy this file to .env and fill it in. The .env file must never be committed.

# Gemini API key (Google AI Studio). Used through the OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Model server on the GPU machine (embedding + reranking), see model_server/.
# The API key must be the same as in model_server/.env.
MODEL_SERVER_URL=http://localhost:8001
MODEL_SERVER_API_KEY=

# Local LLM (Ollama) on the GPU machine. Confidential documents are only ever answered by it.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Vector database
QDRANT_URL=http://localhost:6333

# Chroma: only used by the environment check (step 0)
CHROMA_HOST=localhost
CHROMA_PORT=8000
